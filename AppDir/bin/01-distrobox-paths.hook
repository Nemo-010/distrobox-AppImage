#!/bin/sh

# distrobox bind mounts these scripts into every container it creates and puts
# their paths in the .desktop entries of exported apps, so keep them outside of
# $APPDIR, which changes on every update

export DISTROBOX_BIN_DIR="$DATADIR"/distrobox-appimage

mkdir -p "$DISTROBOX_BIN_DIR"
cp -f "$APPDIR"/bin/distrobox-init "$APPDIR"/bin/distrobox-export \
	"$APPDIR"/bin/distrobox-host-exec "$DISTROBOX_BIN_DIR"

# a copy of these cannot find podman from a desktop entry, launch the AppImage
for f in distrobox distrobox-enter; do
	printf '#!/bin/sh\nexec "${APPIMAGE:?}" "${0##*/}" "$@"\n' > "$DISTROBOX_BIN_DIR/$f"
	chmod +x "$DISTROBOX_BIN_DIR/$f"
done

# podman must read its config from outside the mount too: $APPDIR changes on
# every update, and a config path that is not there stops every podman call.
# @APPDIR@ is expanded here so the conmon and crun paths always point at the
# mount of this launch
if [ -f "$APPDIR"/etc/containers/containers.conf ]; then
	sed "s|@APPDIR@|$APPDIR|g" "$APPDIR"/etc/containers/containers.conf \
		> "$DISTROBOX_BIN_DIR"/containers.conf
	export CONTAINERS_CONF_OVERRIDE="$DISTROBOX_BIN_DIR"/containers.conf
fi

# rootless podman joins the user and mount namespace saved by an earlier run
# (libpod/tmp/pause.pid) before any of its own code runs. A saved namespace
# created without this launch's mount shows $APPDIR as an empty directory, so
# podman cannot find conmon, crun or netavark. If nothing but the pause
# process runs in that namespace, drop it and let podman create one that
# contains this mount. If something else does, such as a container, it must
# stay, and the problem is reported here instead of as a missing crun.
pause_pid_file=${XDG_RUNTIME_DIR:+"$XDG_RUNTIME_DIR"/libpod/tmp/pause.pid}
if [ -n "$pause_pid_file" ] && [ -r "$pause_pid_file" ]; then
	pause_pid=$(cat "$pause_pid_file" 2>/dev/null)
	case "$pause_pid" in
	'' | *[!0-9]*) pause_pid= ;;
	esac
	# a recycled PID must never be killed: podman's pause process is the
	# process whose environ carries _PODMAN_PAUSE=1 (rootless_linux.c)
	if [ -n "$pause_pid" ] && [ -r /proc/"$pause_pid"/environ ] \
		&& tr '\0' '\n' < /proc/"$pause_pid"/environ | grep -qx '_PODMAN_PAUSE=1' \
		&& [ -r /proc/"$pause_pid"/mountinfo ] \
		&& ! grep -qF " $(printf '%s' "$APPDIR" | sed 's/\\/\\134/g; s/ /\\040/g; s/	/\\011/g') " /proc/"$pause_pid"/mountinfo; then
		running=
		for ns in /proc/[0-9]*/ns/mnt; do
			pid=${ns#/proc/}
			pid=${pid%/ns/mnt}
			[ "$pid" = "$pause_pid" ] && continue
			if [ "$ns" -ef /proc/"$pause_pid"/ns/mnt ]; then
				running=1
				break
			fi
		done
		if [ -n "$running" ]; then
			echo "podman's saved namespace (pid $pause_pid) does not contain this AppImage's mount, and other processes, such as containers, still run in it." >&2
			echo "Stop them with the podman that started them, then run this again." >&2
			exit 1
		fi
		kill "$pause_pid" 2>/dev/null
		rm -f "$pause_pid_file" "$XDG_RUNTIME_DIR"/libpod/tmp/ns_handles
	fi
fi
